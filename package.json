{
  "name": "harvest-co",
  "private": true,
  "type": "module",
  "description": "Harvest Co. — full-stack organic grocery with subscription boxes",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "node --watch backend/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "seed": "node backend/seed.js",
    "build": "npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1"
  }
}
